# ==============================================================================
# NutriVedha Environment Configuration Template (.env.example)
# IMPORTANT: Copy to .env for local development. Never commit .env to source control.
# ==============================================================================

# --- APPLICATION CORE ---
NODE_ENV=development
APP_NAME=NutriVedha
APP_VERSION=1.0.0

# --- INGRESS & API GATEWAY ---
PORT=8080
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- CENTRALIZED POSTGRESQL DATABASE ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrivedha?schema=public
PGHOST=localhost
PGPORT=5432
PGDATABASE=nutrivedha
PGUSER=postgres
PGPASSWORD=postgres
PG_POOL_SIZE=20

# --- MICROSERVICES PORTS ---
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
AI_SERVICE_PORT=3003
MEDICAL_SERVICE_PORT=3005
TELEMEDICINE_SERVICE_PORT=3006
MARKETPLACE_SERVICE_PORT=3007
ORDERS_SERVICE_PORT=3008
FITNESS_SERVICE_PORT=3009
NOTIFICATION_SERVICE_PORT=3010
ANALYTICS_SERVICE_PORT=3011

# --- AUTHENTICATION & SECURITY (NEVER EXPOSE IN FRONTEND) ---
JWT_SECRET=replace_with_a_super_secret_high_entropy_256_bit_key_for_jwt_signing
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- MEDICAL RECORD ENCRYPTION (AES-256-GCM) ---
# Must be exactly 64 hex characters (32 bytes)
MEDICAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- AI & GOOGLE GEMINI ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- FRONTEND ENVIRONMENT CONFIGURATIONS (SAFE FOR BROWSER) ---
# frontend/user/.env:
# VITE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_APP_NAME=NutriVedha

# frontend/admin/.env:
# VITE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_APP_NAME="NutriVedha Admin"
