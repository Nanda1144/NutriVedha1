{
  "name": "nutrivedha-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Precision Ayurvedic Intelligence & Integrated HealthTech Ecosystem",
  "workspaces": [
    "frontend/user",
    "frontend/admin",
    "backend",
    "backend/gateway",
    "backend/shared",
    "backend/packages/*",
    "backend/services/*"
  ],
  "scripts": {
    "dev:backend": "npm run --prefix backend dev:all",
    "dev:user": "npm run --prefix frontend/user dev",
    "dev:admin": "npm run --prefix frontend/admin dev",
    "build:backend": "npm run --prefix backend build",
    "build:frontend": "npm run --prefix frontend/user build && npm run --prefix frontend/admin build",
    "db:up": "docker compose -f backend/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f backend/docker-compose.yml down",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run --prefix backend test"
  },
  "keywords": [
    "ayurveda",
    "healthtech",
    "microservices",
    "ai",
    "react19",
    "nodejs",
    "postgresql"
  ],
  "author": "NutriVedha Core Architecture Team",
  "license": "UNLICENSED"
}
